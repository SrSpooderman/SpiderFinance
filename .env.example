POSTGRES_DB=spiderfinance
POSTGRES_USER=spiderfinance
POSTGRES_PASSWORD=change-this-database-password
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
# Dirección y puerto publicados en el equipo anfitrión (solo frontend).
# Usa 0.0.0.0 para acceso directo desde la red local.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
# Destino interno de /api en el contenedor frontend; sin /api ni barra final.
API_UPSTREAM=http://backend:8000
# Tras crear la cuenta inicial, cambia a false antes de publicar el dominio.
REGISTRATION_ENABLED=true
# Solo para clientes de la API en otro origen; el frontend integrado usa /api.
CORS_ORIGINS=http://localhost:8080

# Para ejecutar imágenes publicadas en GHCR (opcional):
# IMAGE_REPOSITORY=propietario/repositorio
# APP_VERSION=latest
