map $http_x_forwarded_proto $client_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

server {
    listen 80;
    add_header Referrer-Policy "no-referrer" always;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location = ${APP_BASE_PATH}api {
        return 308 ${APP_BASE_PATH}api/;
    }

    location = ${APP_BASE_PATH}admin { return 404; }
    location ^~ ${APP_BASE_PATH}admin/ { return 404; }
    location = ${APP_BASE_PATH}api/v1/admin { return 404; }
    location ^~ ${APP_BASE_PATH}api/v1/admin/ { return 404; }

    location ${APP_BASE_PATH}api/ {
        proxy_pass ${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $client_proto;
        proxy_set_header X-SpiderFinance-Admin-Gateway "";
    }

    location ~ ^${APP_BASE_PATH}(docs|redoc)(/|$) {
        return 404;
    }

    location = ${APP_BASE_PATH}openapi.json {
        return 404;
    }

    location ${APP_BASE_PATH} {
        rewrite ^${APP_BASE_PATH}(.*)$ /$1 break;
        try_files $uri $uri/ /index.html;
    }
}
