limit_req_zone $binary_remote_addr zone=admin_login:1m rate=5r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    location = / {
        return 302 /admin;
    }

    location = /admin {
        try_files /index.html =404;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location = /spider-coins.svg {
        try_files $uri =404;
    }

    location = /api/v1/admin/login {
        limit_req zone=admin_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-SpiderFinance-Admin-Gateway local;
    }

    location ^~ /api/v1/admin/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-SpiderFinance-Admin-Gateway local;
    }

    location / {
        return 404;
    }
}
