# Copia a .env.demo. Esta configuración pertenece solo a la instancia pública demo.
POSTGRES_DB=spiderfinance_demo
POSTGRES_USER=spiderfinance_demo
POSTGRES_PASSWORD=change-this-demo-database-password
SECRET_KEY=replace-with-a-different-random-secret-of-at-least-32-characters
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8082
# Proxy HTTPS del portfolio: dirige demo.tudominio.com a 127.0.0.1:8082.
